{%- comment -%}
  Trade Program page: layering test (Nov 19 2026). Linen bands, room photo, ringed step numbers, About-page layout patterns.
  Only used by templates/page.trade-layers.json (?view=trade-layers). Page copy and the form are untouched.
{%- endcomment -%}
<style>
  /* Trade page test: follows the About page patterns (wide split with a brass rule, centered sections, ruled cells) */
  .bh-trade{--bht-linen:#EFE9DE;--bht-canvas:#F8F4EC;--bht-rule:rgba(133,98,55,.35)}
  html,body{overflow-x:clip}
  .bh-trade{margin-left:auto!important;margin-right:auto!important}
  /* top section: intro sits right under the title */
  .bh-trade .hero{align-items:start}
  /* split sections (Why, Members): wider heading column, short brass rule under the heading, like About "The idea" */
  .bh-trade .split{grid-template-columns:minmax(0,2fr) minmax(0,3fr);gap:56px}
  .bh-trade section:has(.grid2) .split>h2::after,
  .bh-trade section:has(.grid2) .split>div:first-child>h2::after{content:"";display:block;width:44px;height:1px;background:var(--brass);margin-top:22px}
  .bh-trade .grid2{gap:28px 40px}
  /* centered sections (Who, How, Apply, FAQ), like About "How we choose" */
  .bh-trade section:has(.who) .split,
  .bh-trade section:has(.steps) .split,
  .bh-trade section:has(form) .split,
  .bh-trade section:has(details) .split{grid-template-columns:1fr;gap:30px;text-align:center;justify-items:center}
  .bh-trade section:has(form) .split>*,.bh-trade section:has(details) .split>*{width:100%;max-width:880px}
  .bh-trade section:has(form) .formcard,.bh-trade section:has(details) details{text-align:left}
  /* linen bands */
  .bh-trade section:has(.who),
  .bh-trade section:has(.steps){background:var(--bht-linen);box-shadow:0 0 0 100vmax var(--bht-linen);clip-path:inset(0 -100vmax);border-top-color:transparent;padding:60px 0}
  .bh-trade section:has(.steps) + section{border-top-color:transparent}
  /* ruled cells: Who it's for (4) and How it works (3) */
  .bh-trade .who,.bh-trade .steps{width:100%;display:grid;gap:0;background:transparent;border:0;border-top:1px solid var(--bht-rule);border-bottom:1px solid var(--bht-rule)}
  .bh-trade .who{grid-template-columns:repeat(4,minmax(0,1fr))}
  .bh-trade .steps{grid-template-columns:repeat(3,minmax(0,1fr))}
  .bh-trade .who>div,.bh-trade .steps>div{background:transparent;border:0;padding:28px 22px;text-align:center}
  .bh-trade .who>div+div,.bh-trade .steps>div+div{border-left:1px solid var(--bht-rule)}
  .bh-trade .who p,.bh-trade .steps p{margin-left:auto;margin-right:auto;max-width:30ch}
  /* ringed step numbers, in the style of the BH seal */
  .bh-trade .steps .n{width:52px;height:52px;border-radius:50%;border:1px solid var(--brass-deep);background:var(--bht-canvas);display:grid;place-items:center;font-family:var(--font-heading-family,'Trirong'),Georgia,serif;font-weight:300;font-size:23px;line-height:1;color:var(--brass-deep);margin:0 auto 16px}
  /* room photo */
  .bht-photo{margin:0;max-width:none;position:relative}
  .bht-photo img{display:block;width:100%;height:auto;max-height:600px;object-fit:cover;object-position:50% 55%}
  .bht-photo + section{border-top-color:transparent}
  @media (max-width:820px){
    .bh-trade .split{grid-template-columns:1fr;gap:24px}
    .bh-trade section:has(.who),.bh-trade section:has(.steps){padding:46px 0}
    .bh-trade .who{grid-template-columns:repeat(2,minmax(0,1fr))}
    .bh-trade .who>div:nth-child(3){border-left:0}
    .bh-trade .who>div:nth-child(n+3){border-top:1px solid var(--bht-rule)}
    .bh-trade .steps{grid-template-columns:1fr}
    .bh-trade .steps>div+div{border-left:0;border-top:1px solid var(--bht-rule)}
    .bh-trade .who>div,.bh-trade .steps>div{padding:24px 14px}
    .bht-photo img{aspect-ratio:4/3}
  }
</style>
<script>
  (function () {
    function add() {
      var who = document.querySelector('.bh-trade .who');
      if (!who || document.querySelector('.bht-photo')) return;
      var sec = who.closest('section'); if (!sec) return;
      var f = document.createElement('figure');
      f.className = 'bht-photo';
      f.innerHTML = '<img src="{{ 'bh-trade-marbella-2000.jpg' | asset_url }}" srcset="{{ 'bh-trade-marbella-1000.jpg' | asset_url }} 1000w, {{ 'bh-trade-marbella-2000.jpg' | asset_url }} 2000w" sizes="100vw" width="2000" height="1125" loading="lazy" alt="A Bramley House living room with the Marbella sofa, two blue barrel chairs and a round brass coffee table">';
      sec.parentNode.insertBefore(f, sec.nextSibling);
      function fit() { f.style.left = '0px'; var r = f.getBoundingClientRect(); f.style.left = (-r.left) + 'px'; f.style.width = document.documentElement.clientWidth + 'px'; }
      fit(); window.addEventListener('resize', fit);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', add); else add();
  })();
</script>

